{
  "name": "leaflet-gameboy",
  "version": "0.1.0",
  "description": "Leaflet tile layer that repaints map tiles in the original Game Boy palette",
  "keywords": [
    "leaflet",
    "leaflet-plugin",
    "gameboy",
    "tiles",
    "palette",
    "svg-filter"
  ],
  "license": "MIT",
  "author": "Luca Lischetti <luca@sirlisko.com>",
  "repository": "github:sirlisko/leaflet-gameboy",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/style.css dist/style.css",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.11.2"
}
